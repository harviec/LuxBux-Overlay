{
  "manifest_version": 3,
  "name": "LuxBux Overlay",
  "version": "1.4.0",
  "description": "Floats your luxthos.io LuxBux balance over Twitch. Only you see it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "luxbux-overlay@harv013",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://luxthos.io/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["overlay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/gold-16.png",
    "32": "icons/gold-32.png",
    "48": "icons/gold-48.png",
    "128": "icons/gold-128.png"
  },
  "action": {
    "default_title": "LuxBux",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/gray-16.png", "32": "icons/gray-32.png" }
  },
  "options_ui": { "page": "popup.html", "open_in_tab": false }
}
