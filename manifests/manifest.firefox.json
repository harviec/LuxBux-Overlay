{
  "manifest_version": 3,
  "name": "LuxBux Overlay",
  "version": "1.1.0",
  "description": "Floats your luxthos.io LuxBux balance over Twitch. Only you see it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "luxbux-overlay@harv013",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://luxthos.io/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["overlay.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "LuxBux", "default_popup": "popup.html" }
}
